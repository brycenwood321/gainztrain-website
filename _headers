/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://widgets.leadconnectorhq.com https://link.msgsndr.com https://stcdn.leadconnectorhq.com https://storage.googleapis.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com https://stcdn.leadconnectorhq.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://widgets.leadconnectorhq.com https://api.leadconnectorhq.com https://backend.leadconnectorhq.com https://maps.googleapis.com https://maps.gstatic.com; frame-src https://link.msgsndr.com https://api.leadconnectorhq.com https://www.youtube.com https://maps.google.com https://www.google.com

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=2592000

/assets/js/*
  Cache-Control: public, max-age=2592000

/data/*
  Cache-Control: public, max-age=300

# Prep dashboard + labels page: NEVER cache. Staff (esp. the iOS Safari home-screen app) were getting a
# stale copy that ignored fixes. no-store guarantees a fresh page every open. Libs under lib/ still cache.
/app/ops/prep/
  Cache-Control: no-store, must-revalidate
/app/ops/prep/labels
  Cache-Control: no-store, must-revalidate
/app/ops/prep/labels.html
  Cache-Control: no-store, must-revalidate
/app/ops/prep/index.html
  Cache-Control: no-store, must-revalidate

/*.html
  Cache-Control: public, max-age=3600

# Serve .md files as plain text so AI tools and humans can read them inline
/*.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Same for llms.txt
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
