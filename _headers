/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://connect.facebook.net https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://widgets.leadconnectorhq.com https://link.msgsndr.com https://stcdn.leadconnectorhq.com https://storage.googleapis.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com https://stcdn.leadconnectorhq.com; img-src 'self' data: https:; connect-src 'self' https://www.facebook.com https://www.google-analytics.com https://region1.google-analytics.com https://widgets.leadconnectorhq.com https://api.leadconnectorhq.com https://backend.leadconnectorhq.com https://maps.googleapis.com https://maps.gstatic.com; frame-src https://link.msgsndr.com https://api.leadconnectorhq.com https://www.youtube.com https://maps.google.com https://www.google.com

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=2592000

/assets/js/*
  Cache-Control: public, max-age=2592000

# ⚠️ attribution.js is the TRACKING script and must NOT inherit the 30-day cache above.
# Found 2026-08-05: browsers were executing a 3,218-byte copy of this file while the deployed
# version was 9,775 bytes — a month-stale build that predated the analytics rewrite (7fa8e6f), so
# for those visitors window.gtTrack was undefined, no visitor/session id was ever generated, and
# every pageview they sent landed with a NULL session_id. Measurement changes were invisible for up
# to 30 days and returning-visitor sessions were silently lost.
# no-cache still stores the file but revalidates every load, so it is a cheap 304 when unchanged and
# always correct the moment we deploy. Never fold this back into the wildcard.
/assets/js/attribution.js
  Cache-Control: no-cache, must-revalidate

/data/*
  Cache-Control: public, max-age=300

# Ops dashboard + labels page: NEVER cache. Staff (esp. the iOS Safari home-screen app) were getting a
# stale copy that ignored fixes. no-store guarantees a fresh page every open. Libs under lib/ still cache.
/app/ops/
  Cache-Control: no-store, must-revalidate
/app/ops/index.html
  Cache-Control: no-store, must-revalidate
/app/ops/meal-labels
  Cache-Control: no-store, must-revalidate
/app/ops/meal-labels.html
  Cache-Control: no-store, must-revalidate

# Menu pages: NEVER cache the HTML, so customers always see the current menu without clearing cache.
# (These pages fetch the live menu data on load; only the small HTML shell is un-cached — its CSS/JS/images
# under /assets/ still cache normally, so there's no real speed hit.)
/menu/
  Cache-Control: no-store, must-revalidate
/menu
  Cache-Control: no-store, must-revalidate
/menu/index.html
  Cache-Control: no-store, must-revalidate
/app/menu/
  Cache-Control: no-store, must-revalidate
/app/menu/index.html
  Cache-Control: no-store, must-revalidate

/*.html
  Cache-Control: public, max-age=3600

# Serve .md files as plain text so AI tools and humans can read them inline
/*.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Same for llms.txt
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
